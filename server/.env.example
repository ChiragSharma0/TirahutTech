# Copy to .env and fill in.
PORT=8787

# Long random string — you type this into /admin to open the dashboard.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Google Analytics 4 reports on the dashboard (optional) ---
# GA4 property ID (Admin → Property settings), digits only.
GA_PROPERTY_ID=
# Path to the service-account JSON key. Add the service account's email as a
# Viewer in GA4 (Admin → Property access management).
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
